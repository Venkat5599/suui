# Vibe-Trading × Sui / Walrus — Signal Vault config
# Copy the lines you need into your real .env. Reads + Walrus storage work
# with just TATUM_API_KEY; on-chain registration also needs the SUI_* keys.

# --- Tatum Sui RPC gateway (required) ---
# Free key from https://dashboard.tatum.io
TATUM_API_KEY=

# Network: mainnet | testnet | devnet  (default: testnet for the vault layer)
SUI_NETWORK=testnet

# Optional explicit RPC override (otherwise derived from SUI_NETWORK):
#   mainnet  https://sui-mainnet.gateway.tatum.io
#   testnet  https://sui-testnet.gateway.tatum.io
#   devnet   https://sui-devnet.gateway.tatum.io
# SUI_RPC_URL=

# --- Walrus decentralized storage (defaults to public testnet hosts) ---
# WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
# WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
# WALRUS_EPOCHS=5

# --- On-chain registration (optional; needs the `sui` extra installed) ---
# Deployed signal_vault Move package id (see sui/signal_vault/README on publish):
SUI_VAULT_PACKAGE=
# Sui private key (suiprivkey... / bech32). KEEP SECRET. Only needed to sign.
SUI_PRIVATE_KEY=
